# AutoIncome v4 — Environment Configuration
# Copy this file to .env and fill in your values

# Core
AUTOINCOME_ENV=development
AUTOINCOME_DEBUG=false
AUTOINCOME_SECRET_KEY=your-secure-random-key-min-32-chars

# Server
AUTOINCOME_HOST=0.0.0.0
AUTOINCOME_PORT=8080
AUTOINCOME_WORKERS=4

# Database (PostgreSQL)
AUTOINCOME_DB_URL=postgresql+asyncpg://autoincome:password@localhost:5432/autoincome
AUTOINCOME_DB_POOL_SIZE=10
AUTOINCOME_DB_MAX_OVERFLOW=20

# Cache (Redis)
AUTOINCOME_REDIS_URL=redis://localhost:6379/0
AUTOINCOME_REDIS_POOL_SIZE=50

# Celery
AUTOINCOME_CELERY_BROKER_URL=redis://localhost:6379/1
AUTOINCOME_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
AUTOINCOME_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AUTOINCOME_RATE_LIMIT=100/minute
AUTOINCOME_MAX_REQUEST_SIZE=1048576
AUTOINCOME_JWT_EXPIRY_MINUTES=60
AUTOINCOME_PASSWORD_MIN_LENGTH=12
AUTOINCOME_MAX_CONCURRENT_REQUESTS=100
AUTOINCOME_TRUSTED_HOSTS=localhost,127.0.0.1

# Features
AUTOINCOME_ENABLE_REGISTRATION=true
AUTOINCOME_ENABLE_NOTIFICATIONS=false
AUTOINCOME_SCAN_INTERVAL_MINUTES=240
AUTOINCOME_MIN_SCORE_THRESHOLD=7.0
AUTOINCOME_HIGH_SCORE_THRESHOLD=8.5

# Logging
AUTOINCOME_LOG_LEVEL=INFO
AUTOINCOME_LOG_FORMAT=json

# Admin
AUTOINCOME_ADMIN_EMAIL=admin@example.com
AUTOINCOME_ADMIN_PASSWORD_HASH=

# Notifications (optional)
AUTOINCOME_PUSHOVER_TOKEN=
AUTOINCOME_PUSHOVER_USER=
AUTOINCOME_WEBHOOK_URL=
AUTOINCOME_SMTP_HOST=
AUTOINCOME_SMTP_PORT=587
AUTOINCOME_SMTP_USER=
AUTOINCOME_SMTP_PASSWORD=
AUTOINCOME_SMTP_TLS=true
AUTOINCOME_SMTP_FROM=

# ── LLM Providers (configure at least one for AI features) ──────

# Moonshot (Kimi) — Recommended
AUTOINCOME_MOONSHOT_API_KEY=
AUTOINCOME_MOONSHOT_MODEL=moonshot-v1-8k

# OpenRouter
AUTOINCOME_OPENROUTER_API_KEY=
AUTOINCOME_OPENROUTER_MODEL=moonshot/kimi-k2.5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (no API key needed)
OLLAMA_HOST=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ── Captcha Solvers (optional) ──────────────────────────────────
AUTOINCOME_2CAPTCHA_KEY=
AUTOINCOME_ANTICAPTCHA_KEY=